{
  "name": "web-admin",
  "version": "0.0.0",
  "nx": {
    "implicitDependencies": [
      "api-client",
      "theme",
      "web-ui"
    ]
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "check-translations": "node ../../scripts/check-app-translations.mjs public/assets/i18n",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\"",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@fontsource-variable/inter": "^5.2.5",
    "@larscom/ngx-translate-module-loader": "^5.1.0",
    "@ngx-translate/core": "^17.0.0",
    "@primeuix/themes": "^3.0.0",
    "assets": "workspace:*",
    "primeicons": "^8.0.0",
    "primeng": "^22.1.0",
    "rxjs": "~7.8.0",
    "shared-utils": "workspace:*",
    "tpl-i18n": "workspace:*",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@coding-with-hassan/eslint-config-spa": "^0.4.0",
    "@coding-with-hassan/prettier-config-spa": "^0.1.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "angular-eslint": "21.4.0",
    "api-types": "workspace:*",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.3",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
