{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      {
        "runtime": "node --version"
      }
    ],
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/.angular/**",
      "!{projectRoot}/dist/**",
      "!{projectRoot}/www/**",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/eslint.config.*"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/www"
      ]
    },
    "lint": {
      "cache": true
    },
    "format:check": {
      "cache": true
    }
  },
  "analytics": false
}
