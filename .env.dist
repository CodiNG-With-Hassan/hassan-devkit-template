# Database
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=template

# CORS (comma-separated origins). The web dev servers reach the API through their own /api
# proxy, so an origin only matters here for a client that calls the API directly.
CORS_ORIGIN=http://localhost:4200,http://localhost:4201

# ── Worktree slots & profiles (see docs/WORKTREES.md) ──
# Slot 0 is the main checkout: compose falls back to these same defaults when the
# DEVKIT_PORT_* variables are absent. `hassan-devkit worktree:env` (run by every
# `pnpm docker:dev:up`) writes the managed block below per checkout — project name,
# profiles, image tag, every port offset by slot × 10 — never edit it by hand.
# Profiles: api (mandatory default) | customer | admin | extras (pgadmin); change them
# with `pnpm worktree:profiles add|remove <name>`. DEVKIT_IMAGE_TAG (hash of the lockfile,
# every package.json and the dev Dockerfiles) selects the shared template-dev-* images.

# ── Managed by hassan-devkit (slot 0) — do not edit by hand ──
# Profiles: hassan-devkit worktree:profiles add|remove <api>.
# Image tag: recomputed by hassan-devkit worktree:env (pnpm docker:dev:up runs it).
COMPOSE_PROJECT_NAME=template
COMPOSE_PROFILES=api
DEVKIT_IMAGE_TAG=latest
DEVKIT_SLOT=0
DEVKIT_BRANCH=main
DEVKIT_PORT_ADMIN=4201
DEVKIT_PORT_API=3000
DEVKIT_PORT_CUSTOMER=4200
DEVKIT_PORT_DB=5432
DEVKIT_PORT_PGADMIN=5050
CUSTOMER_URL=http://localhost:4200
ADMIN_URL=http://localhost:4201
API_PROXY_TARGET=http://localhost:3000
API_SPEC_URL=http://localhost:3000/api-json
