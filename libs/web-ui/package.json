{
  "name": "web-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Shared Angular UI for the web apps (components, pipes, view models). Consumed as source via the @WebUi tsconfig path alias (never built).",
  "sideEffects": false,
  "scripts": {
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\""
  },
  "nx": {
    "implicitDependencies": [
      "api-client",
      "tpl-i18n"
    ]
  },
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@ngx-translate/core": "^17.0.0",
    "api-types": "workspace:*",
    "primeng": "^22.1.0",
    "rxjs": "~7.8.0",
    "shared-utils": "workspace:*",
    "tpl-i18n": "workspace:*",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
