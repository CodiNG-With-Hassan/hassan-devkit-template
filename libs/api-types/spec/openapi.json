{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "summary": "Report that the API is up",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Template API",
    "description": "The API of the template project",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_FAILED",
          "INTERNAL_ERROR",
          "AUTH_UNAUTHORIZED",
          "AUTH_FORBIDDEN",
          "NOT_FOUND",
          "PAYLOAD_TOO_LARGE",
          "RATE_LIMITED"
        ],
        "description": "Stable machine-readable error code (ADR 0002) — the unit of error translation in the frontends."
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "code": {
            "description": "Stable machine-readable error code (ADR 0002) — the unit of error translation in the frontends.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            },
            "description": "Interpolation values for the translated message of `code`, e.g. `{ \"max\": 10 }`."
          },
          "statusCode": {
            "type": "number"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "code",
          "statusCode"
        ]
      }
    }
  }
}
