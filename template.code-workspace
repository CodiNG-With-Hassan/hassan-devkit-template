{
  "folders": [
    { "name": "monorepo", "path": "." },
    { "name": "api (nest)", "path": "api" },
    { "name": "spa (angular)", "path": "spa" }
  ],
  "settings": {
    "eslint.useFlatConfig": true,
    "eslint.workingDirectories": [
      { "directory": "api", "changeProcessCWD": true },
      { "directory": "spa", "changeProcessCWD": true }
    ],
    "prettier.requireConfig": true,
    "typescript.tsdk": "spa/node_modules/typescript/lib"
  },
  "extensions": {
    "recommendations": [
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "angular.ng-template"
    ]
  }
}
