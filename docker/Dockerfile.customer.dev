# Dev image for the customer web app (apps/web-customer, server-side rendered). Build context: the repo root.
FROM node:26-alpine

# Match the packageManager pin in the root package.json.
RUN npm install -g pnpm@11.25.0
ENV HUSKY=0

WORKDIR /workspace

# Every importer's package.json must be present so --frozen-lockfile can
# validate the single workspace lockfile, even for a filtered install.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web-admin/package.json apps/web-admin/
COPY apps/web-customer/package.json apps/web-customer/
COPY libs/api-types/package.json libs/api-types/
COPY libs/api-client/package.json libs/api-client/
COPY libs/assets/package.json libs/assets/
COPY libs/i18n/package.json libs/i18n/
COPY libs/shared-utils/package.json libs/shared-utils/
COPY libs/theme/package.json libs/theme/
COPY libs/web-ui/package.json libs/web-ui/
# api-client, theme and web-ui are consumed as source via tsconfig aliases, not
# as package.json dependencies — include them in the filter or their
# node_modules (the framework deps that make bare imports resolve from libs/)
# are never installed and ng build fails with unresolved imports.
RUN pnpm install --frozen-lockfile --filter web-customer --filter api-client --filter theme --filter web-ui --filter tpl-i18n --filter shared-utils

# No app or libs source in the image: compose bind-mounts apps/web-customer and
# libs (shared as source via the tsconfig aliases) and keeps node_modules in a
# named volume seeded from the install layer above, so every worktree on the
# same lockfile shares one image (docs/WORKTREES.md).

WORKDIR /workspace/apps/web-customer

EXPOSE 4200

CMD ["pnpm", "ng", "serve", "--host", "0.0.0.0", "--port", "4200"]
